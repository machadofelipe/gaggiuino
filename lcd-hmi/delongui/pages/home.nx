  longPressCount.val = 0
  pId = 2
  qPf2.pic = @pic(qpf_on)
  qPf2.pco = 63422
  qPf1.pic = @pic(qpf_off)
  qPf1.pco = 40213
  qPf3.pic = @pic(qpf_off)
  qPf3.pco = 40213
  qPf4.pic = @pic(qpf_off)
  qPf4.pco = 40213
  qPf5.pic = @pic(qpf_off)
  qPf5.pco = 40213
  printh 23 02 54 07

