  longPressCount.val = 0
  pId = 3
  qPf3.pic = @pic(qpf_on)
  qPf3.pco = 63422
  qPf1.pic = @pic(qpf_off)
  qPf1.pco = 40213
  qPf2.pic = @pic(qpf_off)
  qPf2.pco = 40213
  qPf4.pic = @pic(qpf_off)
  qPf4.pco = 40213
  qPf5.pic = @pic(qpf_off)
  qPf5.pco = 40213
  printh 23 02 54 07

on qPf4.down:
  btnPressed.val = qPf4.id
