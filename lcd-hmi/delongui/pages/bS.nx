on bS.load:
  printh 23 02 50 0A
  btGoHome.val = bckHome
  btTempDelta.val = deltaState
  btPrefill.val = basketPrefill

on bS.unload:
  popupMSG.returnid.val = dp

on btGoHome.up:
  bckHome = btGoHome.val

on b2.up:
  page prevPage

on b4.up:
  printh 23 02 54 01

on btTempDelta.up:
  deltaState = btTempDelta.val

on btPrefill.up:
  basketPrefill = btPrefill.val

on tm0.timer:
  if (targetState == 1) {
    modeSelect = 9
  } else if (flushState == 1) {
    modeSelect = 5
  } else if (descaleState == 1) {
    modeSelect = 6
  } else if (ppManualState == 1) {
    modeSelect = 3
  } else if (piState == 0 && ppState == 0) {
    modeSelect = 0
  } else if (piState == 1 && ppState == 0) {
    if (piFlowState == 1) {
      modeSelect = 7
    } else {
      modeSelect = 1
    }
  } else if (piState == 0 && ppState == 1) {
    if (ppType == 1) {
      modeSelect = 8
    } else {
      modeSelect = 2
    }
  } else if (piState == 1 && ppState == 1) {
    if (piFlowState == 1 && ppType == 0) {
      modeSelect = 10
    } else if (piFlowState == 1 && ppType == 1) {
      modeSelect = 11
    } else if (piFlowState == 0 && ppType == 1) {
      modeSelect = 12
    } else {
      modeSelect = 4
    }
  } else {
    modeSelect = 0
  }
