      b22.txt = "d"
      b23.txt = "f"
      b24.txt = "g"
      b25.txt = "h"
      b26.txt = "j"
      b27.txt = "k"
      b28.txt = "l"
      b40.txt = "z"
      b41.txt = "x"
      b42.txt = "c"
      b43.txt = "v"
      b44.txt = "b"
      b45.txt = "n"
      b46.txt = "m"
    } else {
      b0.txt = "Q"
      b1.txt = "W"
      b2.txt = "E"
      b3.txt = "R"
      b4.txt = "T"
      b5.txt = "Y"
      b6.txt = "U"
      b7.txt = "I"
      b8.txt = "O"
      b9.txt = "P"
      b20.txt = "A"
      b21.txt = "S"
      b22.txt = "D"
      b23.txt = "F"
      b24.txt = "G"
      b25.txt = "H"
      b26.txt = "J"
      b27.txt = "K"
      b28.txt = "L"
      b40.txt = "Z"
      b41.txt = "X"
      b42.txt = "C"
      b43.txt = "V"
      b44.txt = "B"
      b45.txt = "N"
      b46.txt = "M"
    }
  }

on tm0.timer:
  if (tm0.tim == 500) {
    tm0.tim = 450
    show.txt = input.txt + "|"
  } else {
    tm0.tim = 500
    show.txt = input.txt
  }

