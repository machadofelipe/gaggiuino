on b200.up:
  input.txt -= 1
  show.txt = input.txt

on b30.up:
  tempstr.txt = ""
  strlen input.txt,temp.val
  temp2.val = 0
  while (temp2.val < temp.val) {
    substr input.txt,ch.txt,temp2.val,1
    if (ch.txt == ".") {
      substr input.txt,tempstr.txt,temp2.val,24
      temp2.val = temp.val
    }
    temp2.val++
  }
  covx input.txt,temp.val,0,0
  if (temp.val > 0) {
    temp.val--
  } else {
    temp.val = 0
  }
  covx temp.val,input.txt,0,0
  input.txt += tempstr.txt
  show.txt = input.txt

on b10.up:
  tempstr.txt = ""
  strlen input.txt,temp.val
  temp2.val = 0
  while (temp2.val < temp.val) {
    substr input.txt,ch.txt,temp2.val,1
    if (ch.txt == ".") {
      substr input.txt,tempstr.txt,temp2.val,24
      temp2.val = temp.val
    }
    temp2.val++
  }
  covx input.txt,temp.val,0,0
  temp.val++
  covx temp.val,input.txt,0,0
  input.txt += tempstr.txt
  show.txt = input.txt

