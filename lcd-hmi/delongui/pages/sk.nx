    tsw skBar,0
    tsw bBrM,0
    tsw bBrP,0
    tsw skFlow,0
    tsw bFlM,0
    tsw bFlP,0
    tsw skRamp,0
    tsw bRmM,0
    tsw bRmP,0
    tsw skEaseInOut,0
    tsw skEaseIn,0
    tsw skEaseOut,0
    tsw skLinear,0
    tsw skInstant,0
    tsw skWAbv,0
    tsw bWaM,0
    tsw bWaP,0
    tsw skAbv,0
    tsw bPaM,0
    tsw bPaP,0
    tsw skBelow,0
