    vis bPaP,1
    vis skAbv,1
    vis skBelowBg,1
    vis t6,1
    vis bPbM,1
    vis bPbP,1
    vis skBelow,1
  }
  skEaseIn.val = 0
  skEaseOut.val = 0
  skEaseInOut.val = 0
  skLinear.val = 0
  skInstant.val = 0
  if (skCrv == 1) {
    skEaseIn.val = 1
  } else if (skCrv == 2) {
    skEaseOut.val = 1
  } else if (skCrv == 0) {
    skEaseInOut.val = 1
  } else if (skCrv == 3) {
    skLinear.val = 1
  } else if (skCrv == 4) {
    skInstant.val = 1
