    skEaseInOut.pic = @pic(crv22_0_dim)
    skEaseInOut.pic2 = @pic(crv22_0_dim_on)
    skEaseIn.pic = @pic(crv22_1_dim)
    skEaseIn.pic2 = @pic(crv22_1_dim_on)
    skEaseOut.pic = @pic(crv22_2_dim)
    skEaseOut.pic2 = @pic(crv22_2_dim_on)
    skLinear.pic = @pic(crv22_3_dim)
    skLinear.pic2 = @pic(crv22_3_dim_on)
    skInstant.pic = @pic(crv22_4_dim)
