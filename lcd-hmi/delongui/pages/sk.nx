on sk.load:
  printh 23 02 50 02
  soakEnabled.val = skState
  click refUI,0
  if (targetState == 1) {
    modeSelect = 9
  } else if (flushState == 1) {
    modeSelect = 5
  } else if (descaleState == 1) {
    modeSelect = 6
  } else if (ppManualState == 1) {
    modeSelect = 3
  } else if (piState == 0 && ppState == 0) {
    modeSelect = 0
  } else if (piState == 1 && ppState == 0) {
    if (piFlowState == 1) {
      modeSelect = 7
    } else {
      modeSelect = 1
    }
  } else if (piState == 0 && ppState == 1) {
    if (ppType == 1) {
      modeSelect = 8
    } else {
      modeSelect = 2
    }
  } else if (piState == 1 && ppState == 1) {
    if (piFlowState == 1 && ppType == 0) {
      modeSelect = 10
    } else if (piFlowState == 1 && ppType == 1) {
      modeSelect = 11
    } else if (piFlowState == 0 && ppType == 1) {
      modeSelect = 12
    } else {
      modeSelect = 4
    }
  } else {
    modeSelect = 0
  }

on sk.unload:
  prevPage = dp
  popupMSG.returnid.val = dp

on b2.up:
  page home

on b0.up:
  page pi

on b5.up:
  page sk

on b8.up:
  page tp

on b6.up:
  page pf

on b3.up:
  page bS

on b4.up:
  page graphPreview

on b7.up:
  printh 23 02 54 01

on soakEnabled.up:
  skState = soakEnabled.val
  click refUI,0

on tabHold.up:
  viewMode.val = 0
  click refUI,0

on tabTrig.up:
  viewMode.val = 1
  click refUI,0

on refUI.up:
