    skTime.pco = 17069
    skBar.pco = 17069
    skFlow.pco = 17069
    skRamp.pco = 17069
    skWAbv.pco = 17069
    skAbv.pco = 17069
    skBelow.pco = 17069
    skTime.pic = @pic(well_56x27_dim)
    skBar.pic = @pic(well_56x27_dim)
    skFlow.pic = @pic(well_56x27_dim)
    skRamp.pic = @pic(well_56x27_dim)
    skWAbv.pic = @pic(well_82x28_dim)
    skAbv.pic = @pic(well_82x28_dim)
    skBelow.pic = @pic(well_82x28_dim)
    bTmM.pic = @pic(step34_m_dim)
    bTmP.pic = @pic(step34_p_dim)
