on bTmM.up:
  if (skTime.val >= 1) {
    skTime.val -= 1
  } else {
    skTime.val = 0
  }

on bTmP.up:
  if (skTime.val <= 59) {
    skTime.val += 1
  } else {
    skTime.val = 60
  }

on bBrM.up:
  if (skBar.val >= 5) {
    skBar.val -= 5
  } else {
    skBar.val = 0
  }

on bBrP.up:
  if (skBar.val <= 115) {
    skBar.val += 5
  } else {
    skBar.val = 120
  }

on bFlM.up:
  if (skFlow.val >= 5) {
    skFlow.val -= 5
  } else {
    skFlow.val = 0
  }

on bFlP.up:
  if (skFlow.val <= 75) {
    skFlow.val += 5
  } else {
    skFlow.val = 80
  }

on bRmM.up:
  if (skRamp.val >= 1) {
    skRamp.val -= 1
  } else {
    skRamp.val = 0
  }

on bRmP.up:
  if (skRamp.val <= 59) {
    skRamp.val += 1
  } else {
    skRamp.val = 60
  }

on bWaM.up:
  if (skWAbv.val >= 10) {
    skWAbv.val -= 10
  } else {
    skWAbv.val = 0
  }

on bWaP.up:
  if (skWAbv.val <= 590) {
    skWAbv.val += 10
  } else {
    skWAbv.val = 600
  }

on bPaM.up:
  if (skAbv.val >= 5) {
    skAbv.val -= 5
  } else {
    skAbv.val = 0
  }

on bPaP.up:
  if (skAbv.val <= 115) {
    skAbv.val += 5
  } else {
    skAbv.val = 120
  }

on bPbM.up:
  if (skBelow.val >= 5) {
    skBelow.val -= 5
  } else {
    skBelow.val = 0
  }

on bPbP.up:
  if (skBelow.val <= 115) {
    skBelow.val += 5
  } else {
    skBelow.val = 120
  }

on skEaseIn.down:
  skCrv = 1
  skEaseIn.val = 1
  skEaseOut.val = 0
  skEaseInOut.val = 0
  skLinear.val = 0
  skInstant.val = 0

on skEaseOut.down:
  skCrv = 2
  skEaseOut.val = 1
  skEaseIn.val = 0
  skEaseInOut.val = 0
  skLinear.val = 0
  skInstant.val = 0

on skEaseInOut.down:
  skCrv = 0
  skEaseInOut.val = 1
  skEaseOut.val = 0
  skEaseIn.val = 0
  skLinear.val = 0
  skInstant.val = 0

on skLinear.down:
  skCrv = 3
  skLinear.val = 1
  skEaseOut.val = 0
  skEaseInOut.val = 0
  skEaseIn.val = 0
  skInstant.val = 0

on skInstant.down:
  skCrv = 4
  skInstant.val = 1
  skEaseOut.val = 0
  skEaseInOut.val = 0
  skLinear.val = 0
  skEaseIn.val = 0

on tm0.timer:
  if (timerState == 1) {
    page brewGraph
  }
  if (targetState == 1) {
    modeSelect = 9
  } else if (flushState == 1) {
    modeSelect = 5
  } else if (descaleState == 1) {
    modeSelect = 6
  } else if (ppManualState == 1) {
    modeSelect = 3
  } else if (piState == 0 && ppState == 0) {
    modeSelect = 0
  } else if (piState == 1 && ppState == 0) {
    if (piFlowState == 1) {
      modeSelect = 7
    } else {
      modeSelect = 1
    }
  } else if (piState == 0 && ppState == 1) {
    if (ppType == 1) {
      modeSelect = 8
    } else {
      modeSelect = 2
    }
  } else if (piState == 1 && ppState == 1) {
    if (piFlowState == 1 && ppType == 0) {
      modeSelect = 10
    } else if (piFlowState == 1 && ppType == 1) {
      modeSelect = 11
    } else if (piFlowState == 0 && ppType == 1) {
      modeSelect = 12
    } else {
      modeSelect = 4
    }
  } else {
    modeSelect = 0
  }
